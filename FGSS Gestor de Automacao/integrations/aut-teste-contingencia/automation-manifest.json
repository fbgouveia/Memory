{
  "id": "aut-teste-contingencia",
  "name": "Integração de Teste de Fila",
  "version": "1.0.0",
  "owner": "CTO Cerebro",
  "cost_level": "low",
  "inputs": [
    {
      "type": "webhook",
      "source": "Webhook de Entrada de Vendas",
      "endpoint_path": "/webhooks/teste-contingencia"
    }
  ],
  "outputs": [
    {
      "type": "Manychat",
      "channel": "WhatsApp Cloud API"
    }
  ],
  "dependencies": [
    "BullMQ",
    "Redis",
    "Express"
  ],
  "rate_limits": {
    "max_requests": 80,
    "duration_ms": 1000
  },
  "contingency": {
    "retry_attempts": 5,
    "use_dlq": true,
    "dlq_mode": "dual_redis_jsonl",
    "dlq_fallback": ".tmp/dlq_fallback.jsonl"
  }
}