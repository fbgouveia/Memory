{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomationManifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Identificador único da automação (ex: aut-recuperacao-pix-kiwify)."
    },
    "name": {
      "type": "string",
      "description": "Nome descritivo da integração."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Versão semântica (ex: 1.0.0)."
    },
    "owner": {
      "type": "string",
      "description": "Responsável técnico/comercial pela automação."
    },
    "cost_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Estimativa de custo operacional de execução."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["webhook", "cron", "polling", "event"],
            "description": "Tipo de entrada ou gatilho."
          },
          "source": {
            "type": "string",
            "description": "De onde vem a informação (ex: Kiwify Checkout, Cron Schedule)."
          },
          "endpoint_path": {
            "type": "string",
            "description": "Caminho relativo do webhook se aplicável (ex: /webhooks/kiwify)."
          }
        },
        "required": ["type", "source"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Destinatário final da integração (ex: Manychat, Clint CRM)."
          },
          "channel": {
            "type": "string",
            "description": "Canal de comunicação (ex: WhatsApp Cloud API, HTTP Request)."
          }
        },
        "required": ["type", "channel"]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de dependências e SaaS de terceiros envolvidos."
    },
    "rate_limits": {
      "type": "object",
      "properties": {
        "max_requests": {
          "type": "integer",
          "description": "Máximo de requisições permitidas."
        },
        "duration_ms": {
          "type": "integer",
          "description": "Janela de tempo do limite em milissegundos."
        }
      },
      "required": ["max_requests", "duration_ms"]
    },
    "contingency": {
      "type": "object",
      "properties": {
        "retry_attempts": {
          "type": "integer",
          "description": "Número de tentativas antes de mover para o DLQ."
        },
        "use_dlq": {
          "type": "boolean",
          "description": "Se a automação deve persistir falhas definitivas na Dead Letter Queue."
        }
      },
      "required": ["retry_attempts", "use_dlq"]
    }
  },
  "required": ["id", "name", "version", "owner", "cost_level", "inputs", "outputs", "dependencies", "rate_limits", "contingency"]
}
