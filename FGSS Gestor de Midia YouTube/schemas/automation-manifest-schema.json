{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YouTubeAutomationManifest",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "Identificador único da automação YouTube (ex: aut-yt-upload-agendado)." },
    "name": { "type": "string", "description": "Nome descritivo da automação." },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "Versão semântica (ex: 1.0.0)." },
    "owner": { "type": "string", "description": "Responsável técnico/comercial pela automação." },
    "channel_id": { "type": "string", "description": "ID do canal YouTube alvo (UC...)." },
    "cost_level": { "type": "string", "enum": ["low", "medium", "high"], "description": "Estimativa de custo de quota/tokens por execução." },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["webhook", "cron", "polling", "event"], "description": "Tipo de gatilho. Event ex: novo vídeo no canal, alerta Content ID." },
          "source": { "type": "string", "description": "De onde vem (ex: YouTube PubSubHubbub, Cron Schedule, Analytics API)." },
          "endpoint_path": { "type": "string", "description": "Caminho do webhook se aplicável (ex: /webhooks/yt-novo-video)." }
        },
        "required": ["type", "source"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "Destino (ex: YouTube Data API, Analytics Ingestor, MAIN BRAIN)." },
          "channel": { "type": "string", "description": "Canal/meio (ex: YouTube upload, HTTP Request to MAIN BRAIN)." }
        },
        "required": ["type", "channel"]
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" }, "description": "SaaS/libs envolvidos (ex: YouTube Data API v3, BullMQ, Redis)." },
    "rate_limits": {
      "type": "object",
      "properties": {
        "max_requests": { "type": "integer", "description": "Máximo de requisições." },
        "duration_ms": { "type": "integer", "description": "Janela do limite em ms." },
        "youtube_quota_points_per_day": { "type": "integer", "description": "Teto de points da YouTube Data API v3 consumidos por dia." }
      },
      "required": ["max_requests", "duration_ms"]
    },
    "contingency": {
      "type": "object",
      "properties": {
        "retry_attempts": { "type": "integer", "description": "Tentativas antes do DLQ." },
        "use_dlq": { "type": "boolean", "description": "Se falhas vão para a DLQ." },
        "dlq_mode": { "type": "string", "enum": ["redis_only", "dual_redis_jsonl"], "description": "Modo da Dead Letter Queue." }
      },
      "required": ["retry_attempts", "use_dlq"]
    }
  },
  "required": ["id", "name", "version", "owner", "cost_level", "inputs", "outputs", "dependencies", "rate_limits", "contingency"]
}
