repos","events_url":"https://api.github.com/users/SampleUser13924398/events{/privacy}","received_events_url":"https://api.github.com/users/SampleUser13924398/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"SampleUser13924398","id":48535081,"node_id":"MDQ6VXNlcjQ4NTM1MDgx","avatar_url":"https://avatars.githubusercontent.com/u/48535081?v=4","gravatar_id":"","url":"https://api.github.com/users/SampleUser13924398","html_url":"https://github.com/SampleUser13924398","followers_url":"https://api.github.com/users/SampleUser13924398/followers","following_url":"https://api.github.com/users/SampleUser13924398/following{/other_user}","gists_url":"https://api.github.com/users/SampleUser13924398/gists{/gist_id}","starred_url":"https://api.github.com/users/SampleUser13924398/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/SampleUser13924398/subscriptions","organizations_url":"https://api.github.com/users/SampleUser13924398/orgs","repos_url":"https://api.github.com/users/SampleUser13924398/repos","events_url":"https://api.github.com/users/SampleUser13924398/events{/privacy}","received_events_url":"https://api.github.com/users/SampleUser13924398/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396","url":"https://api.github.com/repos/Bennettxai/FounderOS-DEMO/commits/ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396","html_url":"https://github.com/Bennettxai/FounderOS-DEMO/commit/ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396"}]},{"sha":"ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396","node_id":"C_kwDOTQZsuNoAKGVjOTcwYThmMzU4Y2ZmMGQ3ZjU5YWE1YmRkOWUzZGZiMmU4MjAzOTY","commit":{"author":{"name":"FounderOS Demo","email":"demo@example.com","date":"2026-08-14T19:23:18Z"},"committer":{"name":"FounderOS Demo","email":"demo@example.com","date":"2026-08-14T19:23:18Z"},"message":"UI sync: collapsible sidebar, runtime host in the footer, lead magnet register\n\nPorts the current operator-console UI:\n\n- Sidebar collapses to an icon rail and drag-resizes, with hover labels when\n  collapsed. Both the width and the collapsed state persist.\n- The footer reads the host at runtime instead of hardcoding localhost, so a\n  deployed instance stops claiming to be local, and the line wraps instead of\n  being clipped by the rail.\n- Lead magnets: a register of every landing page shipped behind a post, as a\n  property table with a create panel and per-row status and delete. Backed by\n  POST /api/lead-magnets and PATCH/DELETE on the id route. Rows carry an\n  origin, and seeding prunes only its own, so a row made in the OS survives a\n  re-seed.\n- Skills read installed plugin skills as well as user skills, and can serve a\n  SKILL.md as a download.\n\nSecurity note on that last one: reading a real skills directory is now OPT-IN.\nIt used to default to ~/.claude, which would make any machine running this\ndemo serve its owner's private skill files over HTTP. Set FOUNDER_OS_SKILLS_DIR\n(or FOUNDER_OS_PLUGINS_DIR) to a directory you are happy to publish; unset, the\ncatalog stays empty.","tree":{"sha":"910ec96267d8191b5baa1df4fc38800fa2827acf","url":"https://api.github.com/repos/Bennettxai/FounderOS-DEMO/git/trees/910ec96267d8191b5baa1df4fc38800fa2827acf"},"url":"https://api.github.com/repos/Bennettxai/FounderOS-DEMO/git/commits/ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Bennettxai/FounderOS-DEMO/commits/ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396","html_url":"https://github.com/Bennettxai/FounderOS-DEMO/commit/ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396","comments_url":"https://api.github.com/repos/Bennettxai/FounderOS-DEMO/commits/ec970a8f358cff0d7f59aa5bdd9e3dfb2e820396/comments","author":{"login":"SampleUser13924398","id":48535081,"node_id":"MDQ6VXNlcjQ4NTM1MDgx","avatar_ur